
FROM lmsysorg/sglang:v0.4.9.post2-cu126

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    CUDA_HOME=/usr/local/cuda \
    MAX_JOBS=4 \
    ENABLE_KVCACHED=true \
    KVCACHED_AUTOPATCH=1

# Build tools for kvcached CUDA/C++ extensions.
RUN apt-get update && apt-get install -y \
    --no-install-recommends \
    git vim nano tmux htop \
    build-essential cmake ninja-build \
    && rm -rf /var/lib/apt/lists/*

# Existing SGLang environment and development tools.
RUN python3 -m pip install \
    ipython pytest psutil pandas

# Verify the existing runtime and CUDA compiler.
RUN python3 -c "import torch, sglang; \
    print('Torch:', torch.__version__); \
    print('CUDA:', torch.version.cuda); \
    print('SGLang:', sglang.__version__)" \
    && nvcc --version

# Add your patched kvcached 0.1.5 source.
COPY kvcached-patched/ /opt/kvcached-src/

# Install required build/runtime dependencies without
# changing the existing torch and sglang packages.
RUN python3 -m pip install \
    ninja setuptools wheel posix_ipc wrapt

# Build kvcached against Python 3.10 and torch 2.7.1.
RUN cd /opt/kvcached-src && \
    python3 -m pip install . \
      --no-build-isolation \
      --no-cache-dir \
      --no-deps

# Install the automatic patch startup hook.
RUN cd /opt/kvcached-src && \
    python3 tools/dev_copy_pth.py

# Verify installation and native extension.
RUN python3 -m pip show kvcached && \
    python3 -c "import kvcached; import kvcached.vmm_ops; print('kvcached installed')"

# Keep the upstream dependency diagnostics non-fatal.
RUN python3 -m pip check || true

WORKDIR /workspace

CMD ["/bin/bash", "-lc", "sleep infinity"]
