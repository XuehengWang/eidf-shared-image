
FROM lmsysorg/sglang:v0.4.9.post2-cu126

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    ENABLE_KVCACHED=false \
    KVCACHED_AUTOPATCH=0

RUN apt-get update && apt-get install -y \
    --no-install-recommends \
    git vim nano tmux htop \
    build-essential cmake ninja-build \
    && rm -rf /var/lib/apt/lists/*

# Development packages are already present in the base image.
# Keep them without upgrading existing dependencies.
RUN python3 -m pip install \
    ipython pytest psutil pandas

# Diagnostic only: upstream image has dependency metadata issues.
RUN python3 -m pip check || true

# Verify the essential packages.
RUN python3 -c "import torch, sglang; \
    print('Torch:', torch.__version__); \
    print('CUDA:', torch.version.cuda); \
    print('SGLang:', sglang.__version__)"

WORKDIR /workspace

CMD ["/bin/bash", "-lc", "sleep infinity"]

